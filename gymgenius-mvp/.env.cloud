# ==========================================
# AI PROVIDER - GROQ ZA CLOUD
# ==========================================
# Groq je BESPLATAN i radi sa llama-3.3-70b-versatile
# Registracija: https://console.groq.com (bez kreditne kartice)
# Free tier: 500K tokena/dan, 6K tokena/min
AI_PROVIDER=groq
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile

# ==========================================
# WGER API (Exercise Database - BESPLATNO)
# ==========================================
WGER_API_BASE_URL=https://wger.de/api/v2
WGER_API_LANGUAGE=2

# ==========================================
# VERCEL APP URL
# ==========================================
# Zameni sa tvojom Vercel domain-om nakon deploy-a
NEXT_PUBLIC_APP_URL=https://gymgenius-mvp.vercel.app


# ============================================================
# KAKO DEPLOYOVATI:
# ============================================================
#
# 1. PRVI PUT - Vercel CLI:
#    cd gymgenius-mvp
#    npm install -g vercel
#    vercel link                    # Linkuj sa Vercel projektom
#    vercel env pull .env.local     # Preuzmi postojeće env vars
#    vercel deploy --prod           # Deploy na produkciju
#
# 2. DRUGI PUT - Git push:
#    git add .
#    git commit -m "feat: Vercel deployment setup"
#    git push origin main           # CI/CD automatski deploy-a
#
# 3. ALTERNATIVA - Vercel Dashboard:
#    - Idi na https://vercel.com/dashboard
#    - Odaberi GymGenius projekt
#    - Settings → Environment Variables
#    - Dodaj sve varijable ispod (kopija/paste)
#
# ============================================================
