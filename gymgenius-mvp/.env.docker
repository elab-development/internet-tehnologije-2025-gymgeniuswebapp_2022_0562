# SIGURNOSNE TAJNE (LOCAL - može biti bilo šta)
# ==========================================
JWT_SECRET=local_dev_secret_change_in_production_min_32_chars
CSRF_SECRET=local_dev_csrf_change_in_production_min_32_chars

# ==========================================
# AI PROVIDER - OLLAMA ZA LOCAL DEVELOPMENT
# ==========================================
# Docker compose će automatski pokrenuti Ollama servis
# docker-compose.yml setuje OLLAMA_BASE_URL=http://ollama:11434
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ==========================================
# WGER API (Exercise Database)
# ==========================================
WGER_API_BASE_URL=https://wger.de/api/v2
WGER_API_LANGUAGE=2

# ==========================================
# LOCAL APP URL
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# KAKO POKRENUTI LOKALNU APP SA DOCKER-OM:
# ============================================================
#
# 1. Kopiraj ovaj fajl:
#    cp .env.docker .env
#
# 2. Pokreni Docker:
#    docker compose up
#
# 3. Čekaj da se Ollama pokrene (healthcheck)
#    - Video će videti: ✓ ollama service healthy
#    - Video će videti: ✓ app service started
#
# 4. Otvori u browser-u:
#    http://localhost:3000
#
# 5. Kreiraj test nalog:
#    - Register: test@example.com / Test123!
#    - Login sa tom kredencijalom
#    - Probaj /ai-workout → Generate Plan
#    - Trebalo bi da vidiš: 🤖 Calling Ollama API with Llama 3.2...
#
# 6. Zaustaviti app:
#    Ctrl+C u terminal-u
#
# ============================================================
#
# NAPOMENA:
# - Docker compose će automatski:
#   * Preuzeti Ollama image
#   * Preuzeti Llama 3.2 model (prvi put, ~4GB, traje ~5-10 min)
#   * Pokrenuti Next.js app na port 3000
#   * Pokrenuti Ollama na port 11434
#
# - Firestore je cloud - logovanje će raditi sa production Firebase
# - Lokalni build je sa output: 'standalone' (za Docker)
#
# ============================================================
